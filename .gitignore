.env
.venv/
venv/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/

# macOS / Python
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

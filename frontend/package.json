{
  "name": "@anny26022/nexus-scanner",
  "version": "0.1.0",
  "description": "Nexus scanner UI as an embeddable React component (ScannerApp). The standalone site builds from the same sources.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anny26022/nexus-scanner.git",
    "directory": "frontend"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist-lib"
  ],
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/embed.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/embed.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "node build_ai_filter_choices.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "node build_ai_filter_choices.mjs && tsc && vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib && npm run check:lib",
    "check:lib": "node lib/checkPackage.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.475.0",
    "openalgo-charts": "^2.6.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.67.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-query": "^5.67.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}

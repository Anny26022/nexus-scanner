{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexus-scanner-local",
  "main": "workers/screener-ai/index.ts",
  "compatibility_date": "2026-10-07",
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }],
  // Local embedding hosts (e.g. Nexus Journal's Vite dev server) may call the AI endpoint.
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://localhost:4173" },
  // Vite serves the frontend. The local Worker only needs published filter choices.
  // Avoid running the full production frontend build on every Worker edit.
  "assets": {
    "binding": "ASSETS",
    "directory": "./frontend/public",
    "run_worker_first": ["/api/*"]
  }
}

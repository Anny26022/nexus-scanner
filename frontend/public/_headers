# Published data is public and read-only. Embedding hosts (Nexus Journal) read it directly from Cloudflare.
/data/*
  Access-Control-Allow-Origin: *
  Access-Control-Expose-Headers: Content-Encoding, Content-Length, ETag
/data/current.json
  Cache-Control: no-cache
/data/results/index.json
  Cache-Control: no-cache
/data/revisions/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

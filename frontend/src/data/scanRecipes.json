  {
    "id": "scan-near-52w-high",
    "name": "Near 52-Week High",
    "category": "Breakouts",
    "horizon": "Positional",
    "description": "Trading within 5% of the 52-week high, with real liquidity.",
    "aka": [
      "near high",
      "52 week high",
      "close to high"
    ],
    "rules": [
      "Within 5% of the 52-week high",
      "20-session average turnover ≥ ₹5 Cr"
    ],
    "expression": {
      "type": "group",
      "op": "AND",
      "children": [
        {
          "type": "condition",
          "kind": "PCT_FROM_52W_HIGH",
          "params": {
            "comparison": "BELOW",
            "pct": 5
          }
        },
        {
          "type": "condition",
          "kind": "AVG_TURNOVER",
          "params": {
            "comparison": "ABOVE",
            "lookbackDays": 20,
            "valueCr": 5
          }
        }
      ]
    }
  },
  {
    "id": "scan-near-high-breakout",
    "name": "Near-High Breakout",
    "category": "Breakouts",
    "horizon": "Swing",
    "description": "Up 3%+ today on above-average volume while within 5% of the yearly high — pushing into new-high territory.",
    "aka": [
      "breakout near high",
      "52 week high breakout",
      "near high breakout"
    ],
    "rules": [
      "Within 5% of the 52-week high",
      "Up at least 3% today",
      "Volume at least 1.5× the 20-day average",
      "20-session average turnover ≥ ₹5 Cr"
    ],
    "expression": {
      "type": "group",
      "op": "AND",
      "children": [
        {
          "type": "condition",
          "kind": "PCT_FROM_52W_HIGH",
          "params": {
            "comparison": "BELOW",
            "pct": 5
          }
        },
        {
          "type": "condition",
          "kind": "PRICE_CHANGE_PCT",
          "params": {
            "overDays": 1,
            "comparison": "ABOVE",
            "pct": 3
          }
        },
        {
          "type": "condition",
          "kind": "VOLUME_VS_AVG",
          "params": {
            "avgDays": 20,
            "multiple": 1.5,
            "withinDays": 1
          }
        },
        {
          "type": "condition",
          "kind": "AVG_TURNOVER",
          "params": {
            "comparison": "ABOVE",
            "lookbackDays": 20,
            "valueCr": 5
          }
        }
      ]
    }
  }

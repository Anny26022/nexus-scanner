{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexus-scanner-local",
  "main": "workers/screener-ai/index.ts",
  "compatibility_date": "2026-10-07",
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }],
  // Vite serves the frontend. The local Worker only needs published filter choices.
  // Avoid running the full production frontend build on every Worker edit.
  "assets": {
    "binding": "ASSETS",
    "directory": "./frontend/public",
    // Pages and agent files go through the Worker for head signals, markdown and discovery; keep in step with SECTIONS.
    "run_worker_first": ["/api/*", "/", "/screener", "/market", "/earnings", "/rotation", "/ipo", "/charts", "/*.md", "/llms.txt", "/llms-full.txt", "/ai.txt", "/robots.txt", "/sitemap.xml"]
  }
}

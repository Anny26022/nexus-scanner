{
  "name": "nexus-scanner",
  "main": "workers/screener-ai/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "build": {
    "command": "npm run build --prefix frontend",
    "watch_dir": ["workers/screener-ai", "frontend/src/data", "frontend/src/api/aiScreenerContract.ts", "frontend/src/api/snapshotScreen.ts", "frontend/src/utils/filterAvailability.ts", "frontend/src/utils/nqlParser.ts"]
  },
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }],
  // Browser origins, besides this Worker's own, allowed to call the AI endpoint (Nexus Journal embeds the scanner).
  // UI_REDIRECT: the screener is used inside Nexus Journal, so a browser opening this Worker's own pages is sent
  // there; /data/* and /api/* keep answering, since the journal fetches them from this address. Remove the variable
  // to serve the UI here again.
  "vars": {
    "ALLOWED_ORIGINS": "https://www.nexusjournal.co.in,https://nexusjournal.co.in",
    "UI_REDIRECT": "https://www.nexusjournal.co.in/scanner"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Published data (/data/*) is read from R2 (workers/screener-ai/siteData.ts), so a refresh needs no rebuild.
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "nexus-screener-chart-data" }],
  // Every request reaches the Worker: API and data are answered there, and page requests are redirected
  // (UI_REDIRECT) before any static file is served. Without UI_REDIRECT the Worker falls through to the assets.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  // Branch previews (Workers Builds) inherit none of the settings above, so they are repeated here. Previews are
  // the staging target for embedding: local dev hosts, Nexus Journal's Vercel branch previews and its Cloudflare Pages
  // preview of the embed branch may call the AI
  // endpoint. Production keeps the exact-origin list above. A separate rate-limit namespace keeps preview
  // traffic out of production's counters.
  "previews": {
    "vars": {
      "ALLOWED_ORIGINS": "https://preview.nexusjournal.co.in,https://*-aniketmahatobcom23-thceduins-projects.vercel.app,https://claude-scanner-embed.new-nexys-ultimate.pages.dev,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3000,http://localhost:4173",
      // Preview addresses serve production data too, so their pages are sent to the journal's fixed preview.
      "UI_REDIRECT": "https://preview.nexusjournal.co.in/scanner"
    },
    "ai": { "binding": "AI" },
    // Previews serve the production data read-only, as they did from the build's static files.
    "r2_buckets": [{ "binding": "DATA", "bucket_name": "nexus-screener-chart-data" }],
    "ratelimits": [{
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }]
  }
}

  {
    "id": "scan-earnings-turnarounds",
    "category": "Earnings",
    "horizon": "Positional",
    "name": "Turnarounds",
    "description": "A loss a year ago, a profit now, with sales growing and profit improving each quarter. Kept apart because growth % from a loss means nothing.",
    "rules": [
      "A loss in the same quarter a year ago, a profit now",
      "Sales up at least 10% year on year",
      "Net profit improving in each of the last three quarters"
    ],
    "aka": [
      "turnaround",
      "turnarounds",
      "loss to profit"
    ],
    "eligibility": {
      "minMarketCapCr": null,
      "minPrice": null,
      "minTurnoverCr": null
    },
    "expression": {
      "type": "group",
      "op": "AND",
      "children": [
        {
          "type": "condition",
          "kind": "TURNAROUND",
          "params": {
            "minSalesPct": 10,
            "maxBehind": 1
          }
        }
      ]
    }
  }

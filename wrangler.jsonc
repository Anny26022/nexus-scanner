{
  "name": "nexus-scanner",
  "main": "workers/screener-ai/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "build": {
    "command": "npm run build --prefix frontend",
    "watch_dir": ["workers/screener-ai", "frontend/src/data", "frontend/src/api/aiScreenerContract.ts", "frontend/src/api/snapshotScreen.ts", "frontend/src/utils/filterAvailability.ts", "frontend/src/utils/nqlParser.ts"]
  },
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // API requests, pages and agent files reach the Worker; assets and data keep static handling.
  "assets": {
    "binding": "ASSETS",
    // Pages and agent files go through the Worker for head signals, markdown and discovery; keep in step with SECTIONS.
    "run_worker_first": ["/api/*", "/", "/screener", "/market", "/earnings", "/rotation", "/ipo", "/charts", "/*.md", "/llms.txt", "/llms-full.txt", "/ai.txt", "/robots.txt", "/sitemap.xml"],
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}

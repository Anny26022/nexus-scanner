[
  {
    "id": "PERSISTENT_MOMENTUM",
    "label": "Persistent Momentum",
    "category": "trend",
    "description": "Price has held decisively above the 10, 20 or 50 EMA for a long run of sessions. Any one of the three thresholds qualifies.",
    "parameters": [
      {
        "id": "ema10Days",
        "label": "10EMA Days",
        "type": "number",
        "defaultValue": 20,
        "unit": "d"
      },
      {
        "id": "ema20Days",
        "label": "20EMA Days",
        "type": "number",
        "defaultValue": 30,
        "unit": "d"
      },
      {
        "id": "ema50Days",
        "label": "50EMA Days",
        "type": "number",
        "defaultValue": 50,
        "unit": "d"
      }
    ]
  },
  {
    "id": "PRICE_VS_EMA",
    "label": "Price vs EMA",
    "category": "trend",
    "description": "Price has stayed on one side of an EMA for at least N sessions. A single close back through the EMA does not reset the run unless a later session trades through that day’s extreme.",
    "parameters": [
      {
        "id": "period",
        "label": "EMA period",
        "type": "number",
        "defaultValue": 20,
        "unit": "p"
      },
      {
        "id": "comparison",
        "label": "Comparison",
        "type": "select",
        "defaultValue": "ABOVE",
        "options": [
          {
            "label": "Above",
            "value": "ABOVE"
          },
          {
            "label": "Below",
            "value": "BELOW"
          }
        ]
      },
      {
        "id": "persistDays",
        "label": "Persist days",
        "type": "number",
        "defaultValue": 10,
        "unit": "d"
      }
    ]
  },
  {
    "id": "EMA_SHAKEOUT",
    "label": "EMA Shakeout & Reclaim",
    "category": "trend",
    "description": "Price dipped below the EMA within the last few sessions and closed back above it — the failed breakdown that traps late sellers.",
    "parameters": [
      {
        "id": "period",
        "label": "EMA period",
        "type": "number",
        "defaultValue": 21,
        "unit": "p"
      },
      {
        "id": "withinDays",
        "label": "Dip within",
        "type": "number",
        "defaultValue": 3,
        "unit": "d"
      }
    ]
  },
  {
